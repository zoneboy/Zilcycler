# ============================================================
# Release signing config template
#
# Copy this file to `keystore.properties` at the repo root and fill in
# your real password. The real file is gitignored — NEVER commit it.
#
#   1. Generate the keystore once:  npm run generate-keystore
#   2. Copy this file:              cp keystore.properties.example keystore.properties
#   3. Fill in storePassword / keyPassword below
#   4. Build the AAB:               npm run release
#
# NOTE on storeFile: Gradle resolves this path relative to android/app/,
# so `../../` points at the repo root where the keystore is generated.
# ============================================================

storeFile=../../zilcycler-release.keystore
storePassword=CHANGE_ME
keyAlias=zilcycler
keyPassword=CHANGE_ME
